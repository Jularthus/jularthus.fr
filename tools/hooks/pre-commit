#!/bin/bash
# Keeps the ?v= cache-busting hashes in public/*.html in sync with the
# CSS/JS being committed. Enabled with: git config core.hooksPath tools/hooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Nothing to do unless a stylesheet or script is part of this commit.
git diff --cached --name-only | grep -qE '^public/assets/(css|js)/' || exit 0

# Rewriting a page would sweep its unstaged edits into this commit.
for page in public/*.html; do
  if ! git diff --quiet -- "$page"; then
    echo "pre-commit: $page has unstaged changes; stage or stash them, then commit again." >&2
    exit 1
  fi
done

python3 tools/stamp-assets.py | while read -r page; do
  git add "$page"
  echo "pre-commit: refreshed asset hashes in $page"
done
